{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "name",
      "bn_name",
      "aliases",
      "category",
      "division",
      "district",
      "area",
      "address",
      "coordinates",
      "phones",
      "website",
      "capacity",
      "capacity_layout",
      "facilities",
      "verification",
      "last_checked",
      "evidence",
      "notes",
      "city"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^bd-[a-z0-9-]+$"
      },
      "name": {
        "type": "string",
        "minLength": 3
      },
      "bn_name": {
        "type": [
          "string",
          "null"
        ]
      },
      "aliases": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "uniqueItems": true
      },
      "category": {
        "enum": [
          "Community Center",
          "Wedding Venue",
          "Banquet Hall",
          "Convention Center",
          "Event Hall"
        ]
      },
      "division": {
        "type": "string"
      },
      "district": {
        "type": "string"
      },
      "area": {
        "type": [
          "string",
          "null"
        ]
      },
      "address": {
        "type": "string",
        "minLength": 5
      },
      "coordinates": {
        "anyOf": [
          {
            "type": "null"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "lat",
              "lon"
            ],
            "properties": {
              "lat": {
                "type": "number",
                "minimum": 20.55,
                "maximum": 26.65
              },
              "lon": {
                "type": "number",
                "minimum": 88,
                "maximum": 92.7
              }
            }
          }
        ]
      },
      "phones": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "number",
            "source",
            "checked",
            "status"
          ],
          "properties": {
            "number": {
              "type": "string",
              "pattern": "^\\+880(1[3-9][0-9]{8}|[2-9][0-9]{6,10})$"
            },
            "source": {
              "type": "string",
              "pattern": "^https://"
            },
            "checked": {
              "type": "string",
              "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$"
            },
            "status": {
              "const": "published-not-call-tested"
            }
          }
        }
      },
      "website": {
        "type": [
          "string",
          "null"
        ],
        "pattern": "^https://"
      },
      "maps_url": {
        "type": "string",
        "pattern": "^https://(maps\\.app\\.goo\\.gl/|www\\.google\\.com/maps/|maps\\.google\\.com/)"
      },
      "review_notice": {
        "type": "string",
        "minLength": 10
      },
      "capacity_note": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "source",
          "checked"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 20
          },
          "source": {
            "type": "string",
            "pattern": "^https://"
          },
          "checked": {
            "type": "string",
            "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$"
          }
        }
      },
      "contact_hours": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "kind",
          "source",
          "checked"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 5
          },
          "kind": {
            "enum": [
              "published-business-hours",
              "booking-office-hours"
            ]
          },
          "source": {
            "type": "string",
            "pattern": "^https://"
          },
          "checked": {
            "type": "string",
            "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$"
          }
        }
      },
      "capacity": {
        "type": [
          "integer",
          "null"
        ],
        "minimum": 1
      },
      "capacity_layout": {
        "type": [
          "string",
          "null"
        ]
      },
      "facilities": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "enum": [
            "Parking",
            "Air conditioning",
            "Catering",
            "Accessible entrance",
            "Accommodation",
            "Stage"
          ]
        }
      },
      "verification": {
        "enum": [
          "source-checked",
          "cross-checked",
          "open-data-listed"
        ]
      },
      "last_checked": {
        "type": "string",
        "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$"
      },
      "evidence": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "url",
            "fields",
            "checked",
            "kind",
            "reuse"
          ],
          "properties": {
            "url": {
              "type": "string",
              "pattern": "^https://"
            },
            "fields": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "checked": {
              "type": "string",
              "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$"
            },
            "kind": {
              "enum": [
                "official",
                "open-data",
                "independent"
              ]
            },
            "reuse": {
              "type": "string",
              "minLength": 5
            }
          }
        }
      },
      "notes": {
        "type": [
          "string",
          "null"
        ]
      },
      "city": {
        "type": "string",
        "minLength": 2
      },
      "capacity_range": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "min",
          "max"
        ],
        "properties": {
          "min": {
            "type": "integer",
            "minimum": 1
          },
          "max": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "address_status": {
        "enum": [
          "published",
          "partial",
          "not_available"
        ]
      },
      "discovery": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "element_type",
          "element_id",
          "element_version",
          "osm_updated",
          "extract_timestamp",
          "geometry_method"
        ],
        "properties": {
          "source": {
            "const": "OpenStreetMap"
          },
          "element_type": {
            "enum": [
              "node",
              "way",
              "relation"
            ]
          },
          "element_id": {
            "type": "integer",
            "minimum": 1
          },
          "element_version": {
            "type": "integer",
            "minimum": 1
          },
          "osm_updated": {
            "type": "string",
            "minLength": 10
          },
          "extract_timestamp": {
            "type": "string",
            "minLength": 10
          },
          "geometry_method": {
            "enum": [
              "mapped_point",
              "building_bbox_center"
            ]
          }
        }
      },
      "area_review": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "method",
          "precision",
          "checked",
          "source",
          "reason"
        ],
        "properties": {
          "method": {
            "enum": [
              "coordinate-and-address-review",
              "named-address-review"
            ]
          },
          "precision": {
            "const": "browsing_locality"
          },
          "checked": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "pattern": "^https://"
          },
          "reason": {
            "type": "string",
            "minLength": 10
          }
        }
      },
      "catering_policy": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "source",
          "checked"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 20
          },
          "source": {
            "type": "string",
            "pattern": "^https://"
          },
          "checked": {
            "type": "string",
            "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$"
          }
        }
      }
    }
  }
}
